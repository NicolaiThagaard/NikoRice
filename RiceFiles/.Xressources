URxvt.font:         xft:DejaVu Sans Mono:pixelsize=14,xft:Symbola
URxvt.boldFont:     xft:DejaVu Sans Mono:style=Bold:pixelsize=14:weight=bold,xft:Symbola
URxvt.italicFont:   xft:DejaVu Sans Mono:style=Oblique:pixelsize=14:slant=italic,xft:Symbola
! Use a 32-bit visual so URxvt's background can be composited by picom.
URxvt.depth: 32
! Make the terminal background transparent; keep glyphs opaque.
URxvt.transparent: true
! Darken the background slightly for contrast (0-100).
URxvt.shading: 20
URxvt.scrollBar: false
URxvt.scrollBar_right: false
URxvt.scrollBar_floating: false
URxvt.scrollstyle: rxvt
URxvt.perl-ext-common: default,selection-to-clipboard,pasta,matcher,keyboard-select
URxvt.keysym.M-u:     perl:url-select:select_next
URxvt.url-launcher:   /usr/bin/chromium-browser
URxvt.underlineURLs:  True
URxvt.matcher.button: 1
URxvt.keysym.M-Escape:perl:keyboard-select:activate
URxvt.keysym.Control-Shift-V:     perl:pasta:paste
URxvt.keysym.Control-Up:   \033[1;5A
URxvt.keysym.Control-Down:    \033[1;5B
URxvt.keysym.Control-Left:    \033[1;5D
URxvt.keysym.Control-Right:    \033[1;5C
URxvt.saveLines: 2000000
URxvt.iso14755: false
